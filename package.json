{
  "name": "lsm-voice",
  "version": "1.0.0",
  "description": "LsmVoice - Chuyển văn bản thành giọng nói tiếng Việt chuyên nghiệp",
  "scripts": {
    "build": "npm run install:all && npm run client:build",
    "start": "cd server && node src/index.js",
    "install:all": "npm install --include=dev && cd server && npm install --include=dev && cd ../client && npm install --include=dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "server:start": "cd server && npm start",
    "client:build": "cd client && npm run build",
    "client:sync": "cd client && npm run cap:sync",
    "android:build": "cd client && npm run android:build",
    "android:bundle": "cd client && npm run android:bundle",
    "android:open": "cd client && npm run android:open",
    "ios:open": "cd client && npm run ios:open",
    "test": "cd server && npm test"
  },
  "keywords": [
    "text-to-speech",
    "tts",
    "vietnamese-tts",
    "voice-audio",
    "vue3",
    "express"
  ],
  "author": "LsmVoice Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
