# Cau hinh may chu LsmVoice
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production

# Cau hinh dich vu gui Email that qua HTTP API (Khuyen nghi cho Render Free Tier vi Render chan cong SMTP 25, 465, 587)
# Dang ky mien phi tai https://brevo.com (300 email/ngay den bat ky email nao)
BREVO_API_KEY=
# Hoac su dung Resend tai https://resend.com (3000 email/thang)
RESEND_API_KEY=

# Cau hinh dich vu gui Email that qua SMTP Gmail (Cho may local hoac may chu khong chan cong SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM="LsmVoice" <your_email@gmail.com>

# Cau hinh tai khoan Quan tri vien (ADMIN) mac dinh khi khoi tao lan dau
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lsmvoice.vn
ADMIN_PASSWORD=Admin@LsmVoice2026!

# Gioi han he thong
MAX_TEXT_LENGTH=50000
CHUNK_SIZE_LIMIT=1200
CONCURRENT_CHUNK_LIMIT=2
MAX_CONCURRENT_JOBS=3

# Nha cung cap TTS mac dinh (edge, azure, fpt, viettel, demo)
DEFAULT_TTS_PROVIDER=edge
