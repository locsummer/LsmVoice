# Dependencies
node_modules/
package-lock.json.bak

# Environment variables & secrets (CRITICAL: Do not commit real passwords/keys)
.env
.env.local
.env.*.local
server/.env
client/.env

# Build outputs
client/dist/
dist/

# SQLite databases & temp journals
server/storage/*.sqlite
server/storage/*.sqlite-journal
server/storage/*.sqlite-wal
server/storage/*.sqlite-shm
*.sqlite

# Generated audio files & uploaded temporary docs
server/storage/audio/*
!server/storage/audio/.gitkeep
server/storage/uploads/*
!server/storage/uploads/.gitkeep

# Logs & debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Mobile native build outputs & keystores
client/android/.gradle/
client/android/app/build/
client/android/local.properties
client/android/**/*.apk
client/android/**/*.aab
client/android/**/*.jks
client/android/**/*.keystore
client/ios/App/Pods/
client/ios/App/build/
*.keystore
*.jks
